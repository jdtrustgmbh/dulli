# Copy to .env and adjust: cp .env.example .env
# Everything except POSTGRES_PASSWORD is optional.

# --- Database (second container) ---
POSTGRES_DB=dulli
POSTGRES_USER=dulli
# Generate one: openssl rand -hex 24   (hex avoids characters that break the connection URL)
POSTGRES_PASSWORD=

# --- App ---
DULLI_PORT=3000
# Public host name, e.g. dulli.example.com
PUBLIC_HOST=

# First login. Used only while no account exists. Leave the password empty to get a random one printed in the app log
# (docker compose logs app | grep bootstrap). The first account is the household owner and has all features.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=

# Signup link for other families (optional): set a long random code, then share https://<your-host>/signup?code=<code>.
# Every family that uses it gets its own household. SIGNUP_LIMIT caps how many families can sign up (default 25).
SIGNUP_CODE=
SIGNUP_LIMIT=25

# Encrypts calendar credentials (Google tokens, CalDAV passwords, ICS links) at rest.
# Generate one: openssl rand -base64 32   - If empty, a random key is created in the data volume.
# Keep a copy: without the key, stored calendar connections cannot be decrypted.
CREDENTIALS_KEY=


# --- Google Calendar (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application".
# Enable the Google Calendar API and add GOOGLE_REDIRECT_URI to the authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/providers/google/callback

